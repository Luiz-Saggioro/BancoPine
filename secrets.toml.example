# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Community Cloud
# (App settings > Secrets). Never commit the real file.
DATABASE_URL = "postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME"
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "change-me-Long-Passw0rd"
ADMIN_NAME = "Administrator"
SESSION_HOURS = "8"
MAX_FAILED_LOGINS = "5"
LOCKOUT_MINUTES = "15"
LIVE_TTL_SECONDS = "3600"
